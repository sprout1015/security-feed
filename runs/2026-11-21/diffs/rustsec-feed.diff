+<title>RUSTSEC-2026-0584: Vulnerability in tokio-rate-limit</title>
+<id>https://rustsec.org/advisories/RUSTSEC-2026-0584.html</id>
+<updated>2026-11-20T12:00:00+00:00</updated>
+<category term="denial-of-service"/>
