+<a href="https://www.first.org/cvss/calculator/3.1#CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:L/I:N/A:H">CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:L/I:N/A:H</a>
+</dd>
+<dt id="patched">Patched</dt>
+<dd>
+<ul>
+<li>
+<code>^0.14.4</code>
+</li>
+<li>
+<code>^0.15.1</code>
+</li>
+<li>
+<code>^0.16.1</code>
+</li>
